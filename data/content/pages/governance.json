        "items": [
          {
            "term": {
              "en": "Doctrine and wording"
            },
            "value": {
              "en": "Decided by Maher. The seven declarations carry his name and are versioned."
            }
          },
          {
            "term": {
              "en": "Status words"
            },
            "value": {
              "en": "Assigned from the fixed nine-word vocabulary on the status register and dated when verified."
            }
          },
          {
            "term": {
              "en": "Corrections"
            },
            "value": {
              "en": "Published with reasons on the corrections page."
            }
          }
        ]
      }
    },
    {
      "type": "steps",
      "title": {
        "en": "How a correction happens"
      },
      "data": {
        "items": [
          {
            "title": {
              "en": "File a defect"
            },
            "text": {
              "en": "Anyone files a defect through the contact page with the reason set to \"Correction\"."
            }
          },
          {
            "title": {
              "en": "Record it"
            },
            "text": {
              "en": "The correction desk records it. The desk address is still to be confirmed."
            },
            "meta": {
              "en": "Desk: to be confirmed"
            }
          },
          {
            "title": {
              "en": "Change or decline"
            },
            "text": {
              "en": "If accepted, the text changes and the change is listed with its date and reason. If declined, the reason is recorded."
            }
          }
        ]
      }
    },
