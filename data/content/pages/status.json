        "en": "How verification works"
      },
      "data": {
        "body": [
          {
            "type": "p",
            "text": {
              "en": "\"Last verified\" means a person looked at the public artefact, or confirmed its absence, on that date. E2 means a public artefact was observed. It does not mean the artefact is good, complete or independently reviewed. That is E3, and no item has it."
            }
          }
        ]
      }
