# W5D — Apache rules. Repository root = document root.
# 1. Deny sensitive folders and file types (also denied per-folder by their own .htaccess).
# 2. Serve real files (assets/*) directly.
# 3. Rewrite everything else to index.php.

Options -Indexes -MultiViews

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Hidden files and VCS metadata
    RewriteRule (^|/)\. - [F,L]

    # Sensitive folders (repository paths only; asset folders are not listed here)
    RewriteRule ^(src|config|data|lang|db|bin|storage|docs|views|tests|\.git)(/|$) - [F,L]

    # Sensitive file types anywhere in the tree
    RewriteRule \.(env|sql|log|md|bak|ini|lock|orig|swp|dist)$ - [F,L]

    # Serve existing files and directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the front controller
    RewriteRule ^ index.php [QSA,L]
</IfModule>
