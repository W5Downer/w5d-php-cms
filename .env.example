# Copy to .env (git-ignored, denied by .htaccess) and fill in. Never commit real values.
APP_URL=https://w5d.tech
APP_DOMAIN=w5d.tech
APP_DEBUG=0
# 64+ random characters. Used for HMAC of CIN/e-mail and IP hashes.
APP_KEY=
# Seed for the fixed 5% sample of weekly reports. Keep it secret and stable.
W5D_SAMPLE_SEED=
W5D_TEMPLATE=ledger
ADMIN_URL_PATH=panel-x9z
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=w5d
DB_USER=w5d
DB_PASSWORD=
# Owner account, created by bin/migrate.php when no user exists.
WEBMASTER_USERNAME=owner
# Generate with: php -r "echo password_hash('YourStrongPassword', PASSWORD_ARGON2ID), PHP_EOL;"
WEBMASTER_PASSWORD_HASH=
REGISTRATION_OPEN=1
# Keep 0 until counsel clears the privacy gate (see docs/design.md).
REGISTRATION_COLLECT_CIN=0
SESSION_SECURE=1
